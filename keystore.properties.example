# Release signing configuration — COPY this file to `keystore.properties` and fill in real values.
#
#   cp keystore.properties.example keystore.properties   (PowerShell: Copy-Item)
#
# The real `keystore.properties` and the keystore itself (*.jks / *.keystore) are gitignored and
# must NEVER be committed. If keystore.properties is absent, release builds fall back to debug
# signing (not distributable).
#
# Generate a release keystore once (2048-bit RSA, ~27 year validity):
#
#   keytool -genkeypair -v \
#     -keystore frontwidget-release.jks \
#     -alias frontwidget \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Keep the resulting .jks file and these passwords backed up somewhere safe: losing them means you
# can no longer publish signed updates for this app.

# Path to the keystore, relative to the repo root (or an absolute path).
storeFile=frontwidget-release.jks

# Password for the keystore file.
storePassword=CHANGE_ME

# Alias of the key inside the keystore (matches -alias above).
keyAlias=frontwidget

# Password for that key (often the same as storePassword).
keyPassword=CHANGE_ME
