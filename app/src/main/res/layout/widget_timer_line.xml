<?xml version="1.0" encoding="utf-8"?>
<!-- Hourglass icon + self-ticking countdown as ONE native line, so the glyph and the time are
     vertically centered together. Previously the hourglass was a Glance Image and the Chronometer
     a separate embedded RemoteViews; mixing Glance layout with an embedded view left the countdown
     floating above the icon. Keeping both in this LinearLayout lets native center_vertical align
     them on the same line. The icon is tinted and the chronometer sized/colored at bind time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/timer_icon"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginEnd="4dp"
        android:src="@drawable/ic_hourglass"
        android:importantForAccessibility="no" />

    <Chronometer
        android:id="@+id/timer_chrono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1" />
</LinearLayout>
